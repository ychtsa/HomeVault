@*
* FILE: ForgotPassword.cshtml
* PROJECT: HomeVault
* FIRST VERSION: 2026-05-01
* DESCRIPTION: Lets a user start the password-recovery flow by entering the
*              email address on their account.
*@

@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="card-title mb-1">Forgot your password?</h2>
                <p class="text-muted small mb-4">
                    Enter the email on your account and we'll send you a link
                    to choose a new password. The link is valid for 60 minutes.
                </p>

                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" type="email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Send reset link</button>
                </form>

                <p class="text-center mt-3 mb-0 small">
                    <a asp-action="Login">Back to log in</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
