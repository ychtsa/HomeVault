@*
* FILE: ForgotPasswordConfirmation.cshtml
* PROJECT: HomeVault
* FIRST VERSION: 2026-05-01
* DESCRIPTION: Generic acknowledgement shown after a password-reset request,
*              regardless of whether the email maps to an account. Returning
*              the same page in either case prevents email enumeration.
*@

@{
    ViewData["Title"] = "Check your email";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4 text-center">
                <h2 class="card-title mb-2">Check your email</h2>
                <p class="text-muted small mb-3">
                    If an account exists for that address, we've sent a link
                    to reset the password. The link expires in 60 minutes.
                </p>
                <p class="small text-muted mb-4">
                    Didn't get an email? Check your spam folder, or
                    <a asp-action="ForgotPassword">try again</a>.
                </p>

                <details class="text-start small mt-3">
                    <summary class="text-muted">Local-development tip</summary>
                    <p class="text-muted mt-2 mb-0">
                        In dev mode, outgoing email is written to the app log
                        (console + <code>logs/homevault-*.log</code>). Look for
                        a line starting with <code>[EMAIL]</code> to grab the
                        reset link. In production, replace
                        <code>LogEmailSender</code> with an SMTP-backed sender.
                    </p>
                </details>

                <a asp-action="Login" class="btn btn-link mt-3">Back to log in</a>
            </div>
        </div>
    </div>
</div>
