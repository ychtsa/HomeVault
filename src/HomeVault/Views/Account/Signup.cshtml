@*
* FILE: Signup.cshtml
* PROJECT: HomeVault
* FIRST VERSION: 2026-04-07
* DESCRIPTION: Self-service registration form.
*@

@model SignupViewModel
@{
    ViewData["Title"] = "Sign up";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="card-title mb-1">Create an account</h2>
                <p class="text-muted small mb-4">Start cataloging the items in your home.</p>

                <form asp-action="Signup" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="ResidentName" class="form-label"></label>
                        <input asp-for="ResidentName" class="form-control" />
                        <span asp-validation-for="ResidentName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ResidentAddress" class="form-label"></label>
                        <input asp-for="ResidentAddress" class="form-control" />
                        <span asp-validation-for="ResidentAddress" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Create account</button>
                </form>

                <p class="text-center mt-3 mb-0 small">
                    Already registered? <a asp-action="Login">Log in</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}