@*
* FILE: Create.cshtml
* PROJECT: HomeVault
* FIRST VERSION: 2026-04-07
* DESCRIPTION: Form for adding a new item to the user's catalog.
*@

@model CatalogItemFormViewModel
@{
    ViewData["Title"] = "Add Item";
}

<div class="row">
    <div class="col-md-7">
        <h1 class="mb-1">Add Item</h1>
        <p class="text-muted mb-4">Catalog something you want to insure.</p>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="ItemName" class="form-label"></label>
                <input asp-for="ItemName" class="form-control" placeholder="e.g. MacBook Pro 14&quot;" />
                <span asp-validation-for="ItemName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ItemType" class="form-label"></label>
                <input asp-for="ItemType" class="form-control" placeholder="e.g. Electronics, Furniture, Jewelry" />
                <span asp-validation-for="ItemType" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ItemValue" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="ItemValue" class="form-control" />
                </div>
                <span asp-validation-for="ItemValue" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Image" class="form-label"></label>
                <input asp-for="Image" type="file" class="form-control"
                       accept="image/jpeg,image/png,image/webp" />
                <div class="form-text">JPEG, PNG, or WebP. 5 MB max.</div>
                <span asp-validation-for="Image" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save Item</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}