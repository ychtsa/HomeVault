@*
* FILE: Edit.cshtml
* PROJECT: HomeVault
* FIRST VERSION: 2026-04-13
* DESCRIPTION: Form for editing an existing catalog item.
*@

@model CatalogItemFormViewModel
@{
    ViewData["Title"] = "Edit Item";
}

<div class="row">
    <div class="col-md-7">
        <h1 class="mb-1">Edit Item</h1>
        <p class="text-muted mb-4">Update the item details.</p>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ItemId" />
            <input type="hidden" asp-for="HasExistingImage" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="ItemName" class="form-label"></label>
                <input asp-for="ItemName" class="form-control" />
                <span asp-validation-for="ItemName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ItemType" class="form-label"></label>
                <input asp-for="ItemType" class="form-control" />
                <span asp-validation-for="ItemType" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ItemValue" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="ItemValue" class="form-control" />
                </div>
                <span asp-validation-for="ItemValue" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Image" class="form-label"></label>
                @if (Model.HasExistingImage)
                {
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <img src="@Url.Action("Image", new { id = Model.ItemId })"
                             alt="Current photo"
                             class="rounded border"
                             style="width: 96px; height: 96px; object-fit: cover;" />
                        <div class="form-check">
                            <input asp-for="RemoveImage" class="form-check-input" />
                            <label asp-for="RemoveImage" class="form-check-label small"></label>
                        </div>
                    </div>
                }
                <input asp-for="Image" type="file" class="form-control"
                       accept="image/jpeg,image/png,image/webp" />
                <div class="form-text">
                    @(Model.HasExistingImage
                        ? "Upload a new photo to replace the current one, or tick the checkbox above to remove it."
                        : "JPEG, PNG, or WebP. 5 MB max.")
                </div>
                <span asp-validation-for="Image" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}